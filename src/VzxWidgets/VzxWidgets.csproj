<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    
    <!-- Metadados do Pacote NuGet -->
    <PackageId>VzxWidgets</PackageId>
    <Version>1.6.0</Version>
    <Authors>VOLPHX</Authors>
    <Company>VOLPHX</Company>
    <Description>Suite moderna completa de componentes WinForms (.NET 8) estilo Guna UI e Dark Gaming UI. Novo tema refinado Pastel Lavender / Periwinkle (#BBC8FE) aplicado globalmente em todos os componentes: VzxButton, VzxCheckBox, VzxTrackBar, VzxProgressBar, VzxToggleSwitch, VzxTextBox, VzxComboBox, VzxDotHeader, VzxKeybind, VzxToast, VzxToastManager, VzxEspPreview e VzxForm.</Description>
    <PackageTags>winforms;ui;guna;controls;modern;custom-controls;volphx;csharp;widgets</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/VOLPHX/VzxWidgets</PackageProjectUrl>
    <RepositoryUrl>https://github.com/VOLPHX/VzxWidgets</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="build\VisualStudioToolsManifest.xml" Pack="true" PackagePath="build\" />
  </ItemGroup>

</Project>
